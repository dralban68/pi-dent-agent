{
  "name": "pi-dent-agent",
  "version": "0.2.18",
  "description": "A generic coding agent as a pi extension: Bash, Task, Agent, Fleet, Script, Search, Markdown and more tools, with billing and terms extensions bundled",
  "keywords": [
    "coding-agent",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/dralban68/pi-dent-agent#readme",
  "bugs": "https://github.com/dralban68/pi-dent-agent/issues",
  "license": "MIT",
  "author": "Chris B <dralban68@protonmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dralban68/pi-dent-agent.git"
  },
  "files": [
    "index.ts",
    "lib/"
  ],
  "type": "module",
  "scripts": {
    "prepare": "node scripts/link-local.ts",
    "test": "node --import \"$PWD/lib/strip-types-hook.mjs\" --test --test-timeout=30000 test/",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "fast-xml-parser": "^5.11.2",
    "file-type": "^22.2.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "ini": "^7.0.0",
    "jiti": "2.7.0",
    "js-yaml": "^5.5.0",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.2",
    "pi-anthropic-oauth": "0.3.9",
    "pi-dent-markdown": "0.1.0",
    "pi-dent-purse": "0.2.0",
    "pi-dent-terms": "0.1.0",
    "pi-mcp-adapter": "7.0.1",
    "pi-web-access": "0.47.0",
    "semver": "^7.8.3",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.93.0",
    "pi-dent-skills": "0.1.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "pi": {
    "extensions": [
      "./index.ts",
      "./node_modules/pi-dent-purse/index.ts",
      "./node_modules/pi-dent-terms/index.ts",
      "./node_modules/pi-mcp-adapter/index.ts",
      "./node_modules/pi-anthropic-oauth/src/index.ts",
      "./node_modules/pi-web-access/dist/index.js"
    ]
  }
}
